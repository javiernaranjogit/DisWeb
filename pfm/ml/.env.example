# Copia este fichero a .env y rellena los valores. .env NO se sube al repositorio.

PORT=1994
MONGODB_URI=mongodb://127.0.0.1:27017/pfmDB

# Debe ser EL MISMO valor que en backend_mon/.env: los tokens se comparten.
JWT_SECRET=

CORS_ORIGIN=*

# Hiperparámetros del entrenamiento
ML_EPOCHS=140
ML_BATCH_SIZE=45

# Aviso por correo al terminar el reentrenamiento nocturno (opcional)
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_NOTIFY_TO=

# Reentrenamiento programado. Desactivado por defecto.
ENABLE_CRON=false
