# Copia este fichero a .env y rellena los valores. .env NO se sube al repositorio.

# Puerto del servicio y conexión a MongoDB
PORT=1988
MONGODB_URI=mongodb://127.0.0.1:27017/pfmDB

# Secreto de firma de los JWT. Obligatorio: el servicio no arranca sin él.
# Generar uno con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=3d

# Origen permitido por CORS. Usa * en desarrollo; en producción, el dominio real.
CORS_ORIGIN=*

# Base de la URL a la que apunta el enlace de recuperación de contraseña
RESET_URL_BASE=http://localhost:8080

# API keys de terceros (https://coinlayer.com y https://coinmarketcap.com)
COINLAYER_API_KEY=
CMC_API_KEY=

# Cuenta SMTP para los correos (recuperación de contraseña y newsletter).
# Con Gmail hay que usar una "contraseña de aplicación", no la del usuario.
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_NOTIFY_TO=

# Tareas programadas (actualización de cotizaciones y noticias). Desactivadas por defecto.
ENABLE_CRON=false
