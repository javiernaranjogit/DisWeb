<?xml version='1.0' encoding='utf-8'?>
<widget id="com.criptovisor.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>CriptoVisor</name>
    <description>
        Seguimiento, análisis y predicción del mercado de criptomonedas.
    </description>
    <author href="https://github.com/javiernaranjogit">
        Javier Naranjo
    </author>
    <content src="index.html" />
    <plugin name="cordova-plugin-whitelist" spec="1" />
    <!-- Whitelist abierta: la app apunta a un backend configurable en
         www/js/config.js. En un despliegue real conviene restringir estos
         orígenes al dominio concreto del servicio. -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <preference name="loglevel" value="ERROR" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
</widget>
